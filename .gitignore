# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/
dist

# Generated by `make e2e/fixture` from
# e2e/testdata/fixture/<caseset>/{schema.yml,data.yml}; not source.
e2e/testdata/fixture/combined.yml

# Trace exports written by the bundled otel-collector fileexporter
# (see e2e/compose.yml --profile otel). The dir itself is tracked via
# .gitkeep so the bind mount target exists.
e2e/otel-output/*
!e2e/otel-output/.gitkeep
